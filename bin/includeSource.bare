# Generate the bundled include library source, "src/includeSource.c" and
# "include/barescript/includeSource.h"
#
# Each include library script is embedded as its parser-compiled script model in the binary
# encoding below, which the runtime reads straight into its compiler with no parser and no model
# objects, deflated as a gzip stream - gzip.bare's matcher with Huffman codes fitted to the model,
# which the runtime's inflater decodes - and emitted as a C unsigned-char array. Each
# array but the required includes' is compiled out by defining NO_BARESCRIPT_INCLUDE_<NAME>. The
# unit tests decode every bundled model with the runtime's inflater and decoder, so the models are
# not verified here.
#
# The binary model encoding (src/model.c, bsScriptFromModelBinary, reads it): a version byte, 1 or
# 2; the string table - a count, then each string as a length and its UTF-8 bytes; the statements -
# a count, then each. Counts, lengths, indexes, and line numbers are unsigned LEB128 varints; a
# string is referred to by its table index plus one, zero meaning none. A version 2 model also
# refers to the shared string table - the strings two or more of the includes use, bundled once and
# ordered by use - through references whose low bit, after the one for none, says shared, the rest
# the index; the parser and linter, which the runtime loads at startup, keep the self-contained
# version 1. A statement is a kind byte
# (1 expr, 2 jump, 3 return, 4 label, 5 function, 6 include), its line number, then its members:
# expr - the name assigned or none, the expression; jump - the label, the condition or none;
# return - the expression or none; label - the name; function - the name, a flags byte (1: the
# last argument takes the rest), the argument count and names, the statement count and
# statements; include - the count, then each include's url and a system flag byte. An expression
# is a tag byte - 0 none, 1 an integer as a zigzag varint, 2 a number as its text, 3 a string,
# 4 a variable, 5 a call (the name, the argument count, the arguments), 6 a binary operator (the
# operator, left, right), 7 a unary operator (the operator, the operand), 8 a group (the
# expression).
#
# Run with the built command-line interface:
#
#   bare bin/includeSource.bare -v vFiles "'<json array of paths>'" \
#       -v vOutputC "'src/includeSource.c'" -v vOutputH "'include/barescript/includeSource.h'"

include <barescriptParser.bare>
include <gzip.bare>


# Append an unsigned LEB128 varint
function includeSourceVarint(bytes, value):
    while value >= 128:
        arrayPush(bytes, value % 128 + 128)
        value = mathFloor(value / 128)
    endwhile
    arrayPush(bytes, value)
endfunction


# A string's reference: its table index plus one, adding it to the table on first use, or, under
# a shared table, the tagged form of its shared or local index
function includeSourceString(encoder, text):
    shared = objectGet(encoder, 'shared')
    if shared != null:
        sharedIndex = objectGet(shared, text)
        if sharedIndex != null:
            return 2 * sharedIndex + 2
        endif
    endif
    stringIndex = objectGet(encoder, 'stringIndex')
    index = objectGet(stringIndex, text)
    if index == null:
        strings = objectGet(encoder, 'strings')
        arrayPush(strings, text)
        index = arrayLength(strings)
        objectSet(stringIndex, text, index)
    endif
    return if(shared != null, 2 * index - 1, index)
endfunction


# Append an expression model, or the none tag for null
function includeSourceExpr(encoder, expr):
    bytes = objectGet(encoder, 'body')
    if expr == null:
        arrayPush(bytes, 0)
    elif objectHas(expr, 'number'):
        number = objectGet(expr, 'number')
        if number == mathFloor(number) && number > -4503599627370496 && number < 4503599627370496:
            arrayPush(bytes, 1)
            includeSourceVarint(bytes, if(number >= 0, 2 * number, -2 * number - 1))
        else:
            arrayPush(bytes, 2)
            includeSourceVarint(bytes, includeSourceString(encoder, jsonStringify(number)))
        endif
    elif objectHas(expr, 'string'):
        arrayPush(bytes, 3)
        includeSourceVarint(bytes, includeSourceString(encoder, objectGet(expr, 'string')))
    elif objectHas(expr, 'variable'):
        arrayPush(bytes, 4)
        includeSourceVarint(bytes, includeSourceString(encoder, objectGet(expr, 'variable')))
    elif objectHas(expr, 'function'):
        call = objectGet(expr, 'function')
        args = objectGet(call, 'args', [])
        arrayPush(bytes, 5)
        includeSourceVarint(bytes, includeSourceString(encoder, objectGet(call, 'name')))
        includeSourceVarint(bytes, arrayLength(args))
        for arg in args:
            includeSourceExpr(encoder, arg)
        endfor
    elif objectHas(expr, 'binary'):
        binary = objectGet(expr, 'binary')
        arrayPush(bytes, 6)
        includeSourceVarint(bytes, includeSourceString(encoder, objectGet(binary, 'op')))
        includeSourceExpr(encoder, objectGet(binary, 'left'))
        includeSourceExpr(encoder, objectGet(binary, 'right'))
    elif objectHas(expr, 'unary'):
        unary = objectGet(expr, 'unary')
        arrayPush(bytes, 7)
        includeSourceVarint(bytes, includeSourceString(encoder, objectGet(unary, 'op')))
        includeSourceExpr(encoder, objectGet(unary, 'expr'))
    else:
        arrayPush(bytes, 8)
        includeSourceExpr(encoder, objectGet(expr, 'group'))
    endif
endfunction


# Append a statement model
function includeSourceStatement(encoder, statement):
    bytes = objectGet(encoder, 'body')
    if objectHas(statement, 'expr'):
        expr = objectGet(statement, 'expr')
        arrayPush(bytes, 1)
        includeSourceVarint(bytes, objectGet(expr, 'lineNumber', 0))
        name = objectGet(expr, 'name')
        includeSourceVarint(bytes, if(name != null, includeSourceString(encoder, name), 0))
        includeSourceExpr(encoder, objectGet(expr, 'expr'))
    elif objectHas(statement, 'jump'):
        jump = objectGet(statement, 'jump')
        arrayPush(bytes, 2)
        includeSourceVarint(bytes, objectGet(jump, 'lineNumber', 0))
        includeSourceVarint(bytes, includeSourceString(encoder, objectGet(jump, 'label')))
        includeSourceExpr(encoder, objectGet(jump, 'expr'))
    elif objectHas(statement, 'return'):
        return_ = objectGet(statement, 'return')
        arrayPush(bytes, 3)
        includeSourceVarint(bytes, objectGet(return_, 'lineNumber', 0))
        includeSourceExpr(encoder, objectGet(return_, 'expr'))
    elif objectHas(statement, 'label'):
        label = objectGet(statement, 'label')
        arrayPush(bytes, 4)
        includeSourceVarint(bytes, objectGet(label, 'lineNumber', 0))
        includeSourceVarint(bytes, includeSourceString(encoder, objectGet(label, 'name')))
    elif objectHas(statement, 'function'):
        function = objectGet(statement, 'function')
        args = objectGet(function, 'args', [])
        statements = objectGet(function, 'statements')
        arrayPush(bytes, 5)
        includeSourceVarint(bytes, objectGet(function, 'lineNumber', 0))
        includeSourceVarint(bytes, includeSourceString(encoder, objectGet(function, 'name')))
        arrayPush(bytes, if(objectGet(function, 'lastArgArray'), 1, 0))
        includeSourceVarint(bytes, arrayLength(args))
        for arg in args:
            includeSourceVarint(bytes, includeSourceString(encoder, arg))
        endfor
        includeSourceVarint(bytes, arrayLength(statements))
        for functionStatement in statements:
            includeSourceStatement(encoder, functionStatement)
        endfor
    else:
        includes = objectGet(objectGet(statement, 'include'), 'includes')
        arrayPush(bytes, 6)
        includeSourceVarint(bytes, objectGet(objectGet(statement, 'include'), 'lineNumber', 0))
        includeSourceVarint(bytes, arrayLength(includes))
        for include in includes:
            includeSourceVarint(bytes, includeSourceString(encoder, objectGet(include, 'url')))
            arrayPush(bytes, if(objectGet(include, 'system'), 1, 0))
        endfor
    endif
endfunction


# Encode a script model as the binary model's bytes
# Encode a model's statements; "shared" maps a shared string to its index, or is null
function includeSourceEncoder(model, shared):
    encoder = {'body': [], 'strings': [], 'stringIndex': {}, 'shared': shared}
    statements = objectGet(model, 'statements')
    includeSourceVarint(objectGet(encoder, 'body'), arrayLength(statements))
    for statement in statements:
        includeSourceStatement(encoder, statement)
    endfor
    return encoder
endfunction


# A string table's bytes - the count, then each string's length and bytes
function includeSourceStringTable(strings):
    bytes = []
    includeSourceVarint(bytes, arrayLength(strings))
    for text in strings:
        textBytes = stringEncode(text)
        includeSourceVarint(bytes, arrayLength(textBytes))
        arrayExtend(bytes, textBytes)
    endfor
    return bytes
endfunction


# The version, the string table, then the statements
function includeSourceEncode(model, shared):
    encoder = includeSourceEncoder(model, shared)
    bytes = [if(shared != null, 2, 1)]
    arrayExtend(bytes, includeSourceStringTable(objectGet(encoder, 'strings')))
    arrayExtend(bytes, objectGet(encoder, 'body'))
    return bytes
endfunction


# Huffman code lengths for "freqs", none longer than "maxBits" - a symbol with no uses gets none
function includeSourceHuffmanLengths(freqs, maxBits):
    n = arrayLength(freqs)
    while true:
        # The leaves in use; a code needs at least two so every code word has a bit
        nodes = []
        for freq, symbol in freqs:
            if freq > 0:
                arrayPush(nodes, [freq, symbol, null, null])
            endif
        endfor
        if arrayLength(nodes) == 0:
            return arrayNewSize(n, 0)
        endif
        if arrayLength(nodes) == 1:
            lengths = arrayNewSize(n, 0)
            arraySet(lengths, arrayGet(arrayGet(nodes, 0), 1), 1)
            return lengths
        endif

        # Combine the two lightest nodes until one remains
        while arrayLength(nodes) > 1:
            arraySort(nodes, includeSourceNodeCompare)
            a = arrayPop(nodes)
            b = arrayPop(nodes)
            arrayPush(nodes, [arrayGet(a, 0) + arrayGet(b, 0), null, a, b])
        endwhile

        # The leaf depths are the code lengths; too deep, halve the counts and retry
        lengths = arrayNewSize(n, 0)
        deepest = includeSourceTreeDepths(arrayGet(nodes, 0), 0, lengths)
        if deepest <= maxBits:
            return lengths
        endif
        scaled = []
        for freq in freqs:
            arrayPush(scaled, if(freq > 0, mathFloor((freq + 1) / 2), 0))
        endfor
        freqs = scaled
    endwhile
endfunction


# Sort nodes heaviest first, so the two lightest pop off the end
function includeSourceNodeCompare(a, b):
    return arrayGet(b, 0) - arrayGet(a, 0)
endfunction


# Record each leaf's depth in "lengths"; returns the deepest
function includeSourceTreeDepths(node, depth, lengths):
    if arrayGet(node, 1) != null:
        arraySet(lengths, arrayGet(node, 1), depth)
        return depth
    endif
    left = includeSourceTreeDepths(arrayGet(node, 2), depth + 1, lengths)
    right = includeSourceTreeDepths(arrayGet(node, 3), depth + 1, lengths)
    return mathMax(left, right)
endfunction


# The literal and match tokens of "bytes" - gzip.bare's matcher at its top level: a literal is
# its byte, a match is 256 + (length - 3) * 32768 + (dist - 1)
function includeSourceTokens(bytes):
    tokens = []
    n = arrayLength(bytes)
    chain = arrayGet(gzipChainByLevel, 9)
    window = gzipWindow
    minMatch = gzipMinMatch
    maxMatch = gzipMaxMatch
    hashMask = gzipHashMask
    hashTable = arrayNewSize(gzipHashSize, -1)
    prev = arrayNewSize(n, -1)
    ix = 0
    while ix < n:
        if ix + minMatch <= n:
            h = ((arrayGet(bytes, ix) * 31 + arrayGet(bytes, ix + 1)) * 31 + \
                arrayGet(bytes, ix + 2)) & hashMask
            bestLen = minMatch - 1
            bestDist = 0
            pos = arrayGet(hashTable, h)
            chainIx = 0
            maxLen = n - ix
            if maxLen > maxMatch:
                maxLen = maxMatch
            endif
            while pos >= 0 && chainIx < chain && ix - pos <= window:
                if arrayGet(bytes, pos) == arrayGet(bytes, ix) && \
                        arrayGet(bytes, pos + bestLen) == arrayGet(bytes, ix + bestLen):
                    matchLen = 0
                    while matchLen < maxLen && \
                            arrayGet(bytes, ix + matchLen) == arrayGet(bytes, pos + matchLen):
                        matchLen = matchLen + 1
                    endwhile
                    if matchLen > bestLen:
                        bestLen = matchLen
                        bestDist = ix - pos
                        if bestLen == maxLen:
                            break
                        endif
                    endif
                endif
                pos = arrayGet(prev, pos)
                chainIx = chainIx + 1
            endwhile
            arraySet(prev, ix, arrayGet(hashTable, h))
            arraySet(hashTable, h, ix)
            if bestLen >= minMatch:
                arrayPush(tokens, 256 + (bestLen - 3) * 32768 + (bestDist - 1))
                k = 1
                while k < bestLen:
                    j = ix + k
                    if j + minMatch <= n:
                        hj = ((arrayGet(bytes, j) * 31 + arrayGet(bytes, j + 1)) * 31 + \
                            arrayGet(bytes, j + 2)) & hashMask
                        arraySet(prev, j, arrayGet(hashTable, hj))
                        arraySet(hashTable, hj, j)
                    endif
                    k = k + 1
                endwhile
                ix = ix + bestLen
                continue
            endif
        endif
        arrayPush(tokens, arrayGet(bytes, ix))
        ix = ix + 1
    endwhile
    return tokens
endfunction


# The run-length form of the code lengths "lengths" (RFC 1951, 3.2.7): each item is a symbol
# 0-18 and, for 16, 17, and 18, its extra bits value
function includeSourceLengthRuns(lengths):
    runs = []
    n = arrayLength(lengths)
    ix = 0
    while ix < n:
        length = arrayGet(lengths, ix)
        run = 1
        while ix + run < n && arrayGet(lengths, ix + run) == length:
            run = run + 1
        endwhile
        if length == 0 && run >= 3:
            count = mathMin(run, 138)
            if count >= 11:
                arrayPush(runs, [18, count - 11])
            else:
                arrayPush(runs, [17, count - 3])
            endif
            ix = ix + count
        elif length != 0 && run >= 4:
            arrayPush(runs, [length, 0])
            count = mathMin(run - 1, 6)
            arrayPush(runs, [16, count - 3])
            ix = ix + 1 + count
        else:
            arrayPush(runs, [length, 0])
            ix = ix + 1
        endif
    endwhile
    return runs
endfunction


# The bit cost of the tokens under a code
function includeSourceTokensCost(tokens, litLengths, distLengths):
    cost = 0
    for token in tokens:
        if token < 256:
            cost = cost + arrayGet(litLengths, token)
        else:
            length = mathFloor((token - 256) / 32768) + 3
            dist = (token - 256) % 32768 + 1
            lenIx = arrayGet(gzipLengthCodeOf, length)
            distIx = gzipDistCode(dist)
            cost = cost + arrayGet(litLengths, 257 + lenIx) + arrayGet(gzipLengthExtra, lenIx) + \
                arrayGet(distLengths, distIx) + arrayGet(gzipDistExtra, distIx)
        endif
    endfor
    return cost + arrayGet(litLengths, 256)
endfunction


# Write the tokens with the literal/length and distance codes, then the end of the block
function includeSourceWriteTokens(writer, tokens, litTable, distTable):
    for token in tokens:
        if token < 256:
            gzipHuffmanWrite(writer, litTable, token)
        else:
            length = mathFloor((token - 256) / 32768) + 3
            dist = (token - 256) % 32768 + 1
            lenIx = arrayGet(gzipLengthCodeOf, length)
            gzipHuffmanWrite(writer, litTable, 257 + lenIx)
            gzipWriteBits(writer, length - arrayGet(gzipLengthBase, lenIx), arrayGet(gzipLengthExtra, lenIx))
            distIx = gzipDistCode(dist)
            gzipHuffmanWrite(writer, distTable, distIx)
            gzipWriteBits(writer, dist - arrayGet(gzipDistBase, distIx), arrayGet(gzipDistExtra, distIx))
        endif
    endfor
    gzipHuffmanWrite(writer, litTable, 256)
endfunction


# Compress "bytes" as a gzip stream: one final block, with Huffman codes fitted to the data when
# that is smaller than the fixed codes - gzip.bare's matcher, bit writer, and code tables
function includeSourceGzip(bytes):
    tokens = includeSourceTokens(bytes)

    # The token frequencies and the codes they fit
    litFreqs = arrayNewSize(286, 0)
    distFreqs = arrayNewSize(30, 0)
    for token in tokens:
        if token < 256:
            arraySet(litFreqs, token, arrayGet(litFreqs, token) + 1)
        else:
            lenIx = arrayGet(gzipLengthCodeOf, mathFloor((token - 256) / 32768) + 3)
            distIx = gzipDistCode((token - 256) % 32768 + 1)
            arraySet(litFreqs, 257 + lenIx, arrayGet(litFreqs, 257 + lenIx) + 1)
            arraySet(distFreqs, distIx, arrayGet(distFreqs, distIx) + 1)
        endif
    endfor
    arraySet(litFreqs, 256, 1)
    litLengths = includeSourceHuffmanLengths(litFreqs, 15)
    distLengths = includeSourceHuffmanLengths(distFreqs, 15)

    # A distance code with fewer than two code words gets two of one bit, so it is complete
    distUsed = 0
    for length in distLengths:
        distUsed = distUsed + if(length, 1, 0)
    endfor
    if distUsed < 2:
        arraySet(distLengths, 0, 1)
        arraySet(distLengths, 1, 1)
    endif

    # The code lengths, run-length coded, and the code-length code that carries them
    nlit = 286
    while nlit > 257 && !arrayGet(litLengths, nlit - 1):
        nlit = nlit - 1
    endwhile
    ndist = 30
    while ndist > 1 && !arrayGet(distLengths, ndist - 1):
        ndist = ndist - 1
    endwhile
    runs = includeSourceLengthRuns(arrayExtend(arraySlice(litLengths, 0, nlit), arraySlice(distLengths, 0, ndist)))
    codeFreqs = arrayNewSize(19, 0)
    for run in runs:
        arraySet(codeFreqs, arrayGet(run, 0), arrayGet(codeFreqs, arrayGet(run, 0)) + 1)
    endfor
    codeLengths = includeSourceHuffmanLengths(codeFreqs, 7)
    ncode = 19
    while ncode > 4 && !arrayGet(codeLengths, arrayGet(gzipCodeLengthOrder, ncode - 1)):
        ncode = ncode - 1
    endwhile

    # The dynamic block, unless the fixed code is smaller
    dynamicCost = 14 + 3 * ncode + includeSourceTokensCost(tokens, litLengths, distLengths)
    for run in runs:
        symbol = arrayGet(run, 0)
        dynamicCost = dynamicCost + arrayGet(codeLengths, symbol) + \
            if(symbol == 16, 2, if(symbol == 17, 3, if(symbol == 18, 7, 0)))
    endfor
    fixedCost = includeSourceTokensCost(tokens, gzipStaticLitLengthsNew(), gzipStaticDistLengthsNew())
    writer = gzipWriterNew()
    if fixedCost <= dynamicCost:
        gzipWriteBits(writer, 3, 3)
        includeSourceWriteTokens(writer, tokens, gzipStaticLit, gzipStaticDist)
    else:
        gzipWriteBits(writer, 5, 3)
        gzipWriteBits(writer, nlit - 257, 5)
        gzipWriteBits(writer, ndist - 1, 5)
        gzipWriteBits(writer, ncode - 4, 4)
        ix = 0
        while ix < ncode:
            gzipWriteBits(writer, arrayGet(codeLengths, arrayGet(gzipCodeLengthOrder, ix)), 3)
            ix = ix + 1
        endwhile
        codeTable = gzipHuffmanBuild(codeLengths)
        for run in runs:
            symbol = arrayGet(run, 0)
            gzipHuffmanWrite(writer, codeTable, symbol)
            if symbol >= 16:
                gzipWriteBits(writer, arrayGet(run, 1), if(symbol == 16, 2, if(symbol == 17, 3, 7)))
            endif
        endfor
        includeSourceWriteTokens(writer, tokens, gzipHuffmanBuild(litLengths), gzipHuffmanBuild(distLengths))
    endif
    gzipWriteFlush(writer)

    # The gzip header, the block, and the CRC and size trailer
    gzipBytes = [31, 139, 8, 0, 0, 0, 0, 0, 2, 255]
    arrayExtend(gzipBytes, arrayGet(writer, 0))
    arrayExtend(gzipBytes, gzipU32Bytes(gzipCrc32Bytes(bytes)))
    arrayExtend(gzipBytes, gzipU32Bytes(arrayLength(bytes)))
    return gzipBytes
endfunction


# The required includes - the runtime bootstraps its parser and linter from these, so they are
# always bundled
includeSourceRequired = ['barescriptParser.bare', 'barescriptLint.bare']


# Sort strings by use count, most used first, then by text
function includeSourceUseCompare(uses, a, b):
    difference = objectGet(uses, b) - objectGet(uses, a)
    return if(difference != 0, difference, if(a < b, -1, if(a > b, 1, 0)))
endfunction


# Bytes as lines of C hex literals, 18 per line
function includeSourceHexLines(bytes, hex):
    lines = []
    lineParts = []
    for byte, ixByte in bytes:
        arrayPush(lineParts, arrayGet(hex, byte))
        if arrayLength(lineParts) == 18 || ixByte == arrayLength(bytes) - 1:
            arrayPush(lines, '    ' + arrayJoin(lineParts, ', '))
            lineParts = []
        endif
    endfor
    return lines
endfunction


async function main():
    files = jsonParse(systemGlobalGet('vFiles', '[]'))
    outputC = systemGlobalGet('vOutputC')
    outputH = systemGlobalGet('vOutputH')
    if !files || outputC == null || outputH == null:
        systemLog('usage: bare bin/includeSource.bare -v vFiles "..." -v vOutputC "..." -v vOutputH "..."')
        return 1
    endif

    licenseC = '/* Licensed under the MIT License\n' + \
        '   https://github.com/craigahobbs/bare-script-c/blob/main/LICENSE */\n'
    generated = '/* This file is generated by "make includes" - do not edit */\n'

    # The header - one accessor per bundled include, plus the registry
    headerParts = [licenseC, '\n', generated, '\n', \
        '/*\n' + \
        ' * The bundled BareScript include library\n' + \
        ' *\n' + \
        ' * Each include is embedded as its parser-compiled script model in the binary encoding\n' + \
        ' * bin/includeSource.bare describes, gzip-compressed. An accessor inflates its include\'s\n' + \
        " * model on first use and caches it for the calling thread; the bytes are released by\n" + \
        ' * bsIncludeCleanup. An include compiled out of the library\n' + \
        ' * with its NO_BARESCRIPT_INCLUDE_<NAME> macro - see src/includeSource.c - keeps its\n' + \
        ' * registry entry and accessor, which return no model.\n' + \
        ' */\n\n' + \
        '#ifndef BARESCRIPT_INCLUDE_SOURCE_H\n' + \
        '#define BARESCRIPT_INCLUDE_SOURCE_H\n\n' + \
        '#include <stddef.h>\n\n' + \
        '#include "export.h"\n\n' + \
        '#ifdef __cplusplus\nextern "C" {\n#endif\n\n' + \
        'BS_VISIBILITY_BEGIN\n\n\n' + \
        '/* The number of bundled include library scripts */\n' + \
        '#define BS_INCLUDE_COUNT ']

    # The source
    sourceParts = [licenseC, '\n', generated, '\n' + \
        '#include "barescript/includeSource.h"\n\n' + \
        '#include "internal.h"\n\n\n' + \
        '/*\n' + \
        ' * Compiling out includes\n' + \
        ' *\n' + \
        ' * Define NO_BARESCRIPT_INCLUDE_<NAME> - the include file name without ".bare" in upper case, as in\n' + \
        " * NO_BARESCRIPT_INCLUDE_MARKDOWNUP - to leave that include's model out of the library. The include\n" + \
        ' * keeps its registry entry and accessor, which return no model, so an include statement for it is\n' + \
        ' * served from the system include path, if one is registered, or fails. An include that an included\n' + \
        ' * script itself includes must be kept along with it. ' + arrayJoin(includeSourceRequired, ' and ') + '\n' + \
        ' * are always bundled - the runtime parses with them.\n' + \
        ' */\n']

    # The byte values as C hex literals
    digits = stringSplit('0123456789abcdef', '')
    hex = []
    for high in digits:
        for low in digits:
            arrayPush(hex, '0x' + high + low)
        endfor
    endfor

    # Parse every include script into its model
    models = []
    for file in files:
        text = systemFetch(file)
        if text == null:
            systemLog('error: failed to read "' + file + '"')
            return 1
        endif
        includeName = stringSlice(file, stringLastIndexOf(file, '/') + 1)
        parseResult = barescriptParseScriptEx(text, 1, includeName)
        if objectHas(parseResult, 'error'):
            systemLog(objectGet(objectGet(parseResult, 'error'), 'message'))
            return 1
        endif
        arrayPush(models, {'name': includeName, 'text': text, 'model': objectGet(parseResult, 'result')})
    endfor

    # The shared string table: every string two or more of the optional includes use, the most used
    # first so the common references are short
    uses = {}
    for entry in models:
        if arrayIndexOf(includeSourceRequired, objectGet(entry, 'name')) == -1:
            for text in objectGet(includeSourceEncoder(objectGet(entry, 'model'), null), 'strings'):
                objectSet(uses, text, objectGet(uses, text, 0) + 1)
            endfor
        endif
    endfor
    sharedStrings = []
    for text in objectKeys(uses):
        if objectGet(uses, text) >= 2:
            arrayPush(sharedStrings, text)
        endif
    endfor
    arraySort(sharedStrings, systemPartial(includeSourceUseCompare, uses))
    shared = {}
    for text, ixText in sharedStrings:
        objectSet(shared, text, ixText)
    endfor
    sharedCompressed = includeSourceGzip(includeSourceStringTable(sharedStrings))
    arrayPush(sourceParts, '\n\n/* The shared string table - ' + arrayLength(sharedStrings) + ' strings */\n' + \
        'static const unsigned char bsIncludeSourceDataShared[] = {\n' + \
        arrayJoin(includeSourceHexLines(sharedCompressed, hex), ',\n') + '\n};\n' + \
        'const BSIncludeSource bsIncludeSourceShared = {"shared", bsIncludeSourceDataShared, sizeof(bsIncludeSourceDataShared)};\n')

    # Each include library script
    accessors = []
    registry = []
    stubs = []
    totalSource = 0
    totalEncoded = arrayLength(sharedCompressed)
    for entry, ixFile in models:
        includeName = objectGet(entry, 'name')
        baseName = stringSlice(includeName, 0, stringLength(includeName) - 5)
        exportName = stringUpper(stringCharAt(baseName, 0)) + stringSlice(baseName, 1)
        macroName = stringUpper(baseName)

        # Encode the model - a required include self-contained - compress it, and emit the bytes
        # as a C initializer
        required = arrayIndexOf(includeSourceRequired, includeName) != -1
        compressed = includeSourceGzip(includeSourceEncode(objectGet(entry, 'model'), if(required, null, shared)))
        totalSource = totalSource + stringLength(objectGet(entry, 'text'))
        totalEncoded = totalEncoded + arrayLength(compressed)
        lines = includeSourceHexLines(compressed, hex)

        # The data, compiled out by its macro unless the include is required
        arrayPush(sourceParts, '\n\n/* ' + includeName + ' */\n' + \
            if(required, '', '#ifndef NO_BARESCRIPT_INCLUDE_' + macroName + '\n') + \
            'static const unsigned char bsIncludeSourceData' + exportName + '[] = {\n' + \
            arrayJoin(lines, ',\n') + '\n};\n' + \
            '#define BS_INCLUDE_SOURCE_' + macroName + ' bsIncludeSourceData' + exportName + \
            ', sizeof(bsIncludeSourceData' + exportName + ')\n' + \
            if(required, '', '#else\n#define BS_INCLUDE_SOURCE_' + macroName + ' NULL, 0\n#endif\n') + \
            '\nconst unsigned char *bsIncludeSource' + exportName + '(size_t *size)\n{\n' + \
            '    return bsIncludeSourceDecode(' + ixFile + ', size);\n}\n')
        arrayPush(accessors, '/* ' + includeName + ' - the inflated binary script model and its size */\n' + \
            'const unsigned char *bsIncludeSource' + exportName + '(size_t *size);')
        arrayPush(registry, '    {"' + includeName + '", BS_INCLUDE_SOURCE_' + macroName + '}')
        arrayPush(stubs, '    bsIncludeSource' + exportName)
    endfor

    # The include registry and the stub accessor table
    arrayPush(sourceParts, '\n\n/* The bundled include library registry */\n' + \
        'BSIncludeSource bsIncludeSources[] = {\n' + arrayJoin(registry, ',\n') + '\n};\n\n\n' + \
        '/* The bundled include library stub accessors, in registry order */\n' + \
        'const BSIncludeSourceFn bsIncludeSourceStubs[] = {\n' + arrayJoin(stubs, ',\n') + '\n};\n')

    arrayPush(headerParts, arrayLength(files) + '\n\n\n' + \
        "/* A bundled include library stub accessor - returns its include's inflated binary script model and its size */\n" + \
        'typedef const unsigned char *(*BSIncludeSourceFn)(size_t *size);\n\n' + \
        '/* The bundled include library stub accessors, in registry order */\n' + \
        'extern const BSIncludeSourceFn bsIncludeSourceStubs[BS_INCLUDE_COUNT];\n\n\n' + \
        '/*\n * The bundled include library stub accessors\n */\n\n' + \
        arrayJoin(accessors, '\n\n') + '\n\n\n' + \
        'BS_VISIBILITY_END\n\n\n' + \
        '/*\n * The registry tables - the implementation\'s and its tests\', not exported\n */\n\n' + \
        '/* A bundled include library script */\n' + \
        'typedef struct BSIncludeSource {\n' + \
        '    const char *name;\n' + \
        '    const unsigned char *gzip;\n' + \
        '    size_t gzipSize;\n' + \
        '} BSIncludeSource;\n\n' + \
        '/* The bundled include library registry, in name order */\n' + \
        'extern BSIncludeSource bsIncludeSources[BS_INCLUDE_COUNT];\n\n' + \
        '/* The shared string table - the strings the optional includes\' models refer to in common */\n' + \
        'extern const BSIncludeSource bsIncludeSourceShared;\n\n' + \
        '#ifdef __cplusplus\n}\n#endif\n\n#endif\n')

    # Write the generated files
    systemFetch({'url': outputH, 'body': arrayJoin(headerParts, '')})
    systemFetch({'url': outputC, 'body': arrayJoin(sourceParts, '')})
    systemLog('includeSource: ' + arrayLength(files) + ' includes, ' + totalSource + ' source bytes, ' + \
        totalEncoded + ' compressed bytes (' + numberToFixed(100 * totalEncoded / totalSource, 1) + '%)')
    return 0
endfunction


return main()
