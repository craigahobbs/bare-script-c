function testPerfFmtPerf():
    unittestEqual(perfFmtPerf(null), '')
    unittestEqual(perfFmtPerf(3.8), '3.8 ms')
    unittestEqual(perfFmtPerf(195), '195 ms')
    unittestEqual(perfFmtPerf(9000), '9.00 s')
    unittestEqual(perfFmtPerf(15000), '15.0 s')
    unittestEqual(perfFmtPerf(160000), '160 s')
    unittestEqual(perfFmtPerf(1590000), '1,590 s')
endfunction
unittestRunTest('testPerfFmtPerf')


