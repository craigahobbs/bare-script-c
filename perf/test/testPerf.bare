    unittestEqual( \
        perfIncludeLegend(testPerfData), \
        'The other rows: JavaScript (V8) is a native JavaScript port and BareScript (JS) is the ' + \
            'JavaScript implementation.' \
    )
endfunction
unittestRunTest('testPerfIncludeLegend')


function testPerfIncludeNote():
    unittestEqual(perfIncludeNote({}), '')
    unittestEqual( \
        perfIncludeNote(testPerfData), \
        'The C port runs 1 of the 9 tests, too few for a score, so it is left out.' \
    )
endfunction
unittestRunTest('testPerfIncludeNote')


# The C port is compared as a ratio of means over the tests both run, not by the table's fit
function testPerfVsCPhrase():
    unittestEqual(perfVsCPhrase({}), '')
    unittestEqual(perfVsCPhrase(testPerfData), '11.3x slower than C (mandelbrot)')
    unittestEqual(perfVsCPhrase({'includeLibrary': {'C': {'urlEncode': 1}}}), '')
    unittestEqual(perfVsCPhrase({'includeLibrary': { \
        'C': {'urlEncode': 1}, \
        'BareScript (C)': {'mandelbrot': 5} \
    }}), '')
    unittestEqual(perfVsCPhrase({'includeLibrary': { \
        'C': {'mandelbrot': 1}, \
        'BareScript (C)': {'mandelbrot': 0} \
    }}), '')
    faster = {'includeLibrary': { \
        'C': {'mandelbrot': 10, 'urlEncode': 0}, \
        'BareScript (C)': {'mandelbrot': 5, 'urlEncode': 8} \
    }}
    unittestEqual(perfVsCPhrase(faster), '2.0x faster than C (mandelbrot)')
    twoTests = {'includeLibrary': { \
        'C': {'mandelbrot': 2, 'urlEncode': 8}, \
        'BareScript (C)': {'mandelbrot': 8, 'urlEncode': 32} \
    }}
    unittestEqual(perfVsCPhrase(twoTests), '4.0x slower than C')
    tie = {'includeLibrary': { \
        'C': {'mandelbrot': 5}, \
        'BareScript (C)': {'mandelbrot': 5} \
    }}
    unittestEqual(perfVsCPhrase(tie), '1.0x faster than C (mandelbrot)')
endfunction
unittestRunTest('testPerfVsCPhrase')


function testPerfStartupBlurb_empty():
    unittestEqual( \
        perfStartupBlurb({}), \
        'Each figure is for the empty program: the wall time of the whole process, and the ' + \
            'memory an interpreter takes before it runs any code.' \
    )
    unittestEqual( \
        perfStartupExtra(testPerfData), \
        'BareScript (C) starts in 2.5 ms, the fastest. JavaScript (V8 JIT) takes 26.0 ms, ' + \
            '10.4x slower than BareScript (C).' \
    )
    data = {'crossLanguage': {'empty': { \
        'bare': {'wall_ms': 2.7, 'rss_mb': 2.5}, \
        'lua': {'wall_ms': 2.5, 'rss_mb': 1.7}, \
        'js': {'wall_ms': 26, 'rss_mb': 38} \
    }}}
    unittestEqual( \
        perfStartupExtra(data), \
        'BareScript (C) starts in 2.7 ms, the second fastest, and 9.6x faster than ' + \
            'JavaScript (V8 JIT), the next slowest.' \
    )
    dataPerl = {'crossLanguage': {'empty': { \
        'bare': {'wall_ms': 2.7, 'rss_mb': 2.5}, \
        'lua': {'wall_ms': 2.5, 'rss_mb': 1.7}, \
        'pl': {'wall_ms': 4.4, 'rss_mb': 4.3}, \
        'js': {'wall_ms': 26, 'rss_mb': 38} \
    }}}
    unittestEqual( \
        perfStartupExtra(dataPerl), \
        'BareScript (C) starts in 2.7 ms, the second fastest, and 1.6x faster than Perl, the ' + \
            'next slowest. JavaScript (V8 JIT) takes 26.0 ms, 9.6x slower than BareScript (C).' \
    )
    dataJsNext = {'crossLanguage': {'empty': { \
        'bare': {'wall_ms': 2.5, 'rss_mb': 2.5}, \
        'js': {'wall_ms': 26, 'rss_mb': 38} \
    }}}
    unittestEqual( \
        perfStartupExtra(dataJsNext), \
        'BareScript (C) starts in 2.5 ms, the fastest, and 10.4x faster than ' + \
            'JavaScript (V8 JIT), the next slowest.' \
    )
    dataJsBest = {'crossLanguage': {'empty': { \
        'bare': {'wall_ms': 30, 'rss_mb': 2.5}, \
        'js': {'wall_ms': 10, 'rss_mb': 38} \
    }}}
    unittestEqual( \
        perfStartupExtra(dataJsBest), \
        'BareScript (C) starts in 30.0 ms, the second fastest.' \
    )
    dataAlone = {'crossLanguage': {'empty': {'bare': {'wall_ms': 2.5, 'rss_mb': 2.5}}}}
    unittestEqual(perfStartupExtra(dataAlone), 'BareScript (C) starts in 2.5 ms, the fastest.')
endfunction
unittestRunTest('testPerfStartupBlurb_empty')


function testPerfMemoryBlurb_empty():
    unittestEqual( \
        perfMemoryBlurb({}), \
        "Each figure is an application's peak resident set under `make perfx`. `empty` is the " + \
            "empty program - the interpreter's own baseline, which every other figure includes." \
    )
    unittestEqual( \
        perfMemoryExtra({'crossLanguage': {'empty': {'bare': {'rss_mb': 2.5, 'wall_ms': 2}}}}), \
        "BareScript (C)'s minimum footprint is 2.5 MB, the lowest." \
    )
    dataNotBest = {'crossLanguage': { \
        'empty': { \
            'bare': {'rss_mb': 5, 'wall_ms': 2}, \
            'lua': {'rss_mb': 1, 'wall_ms': 2} \
        }, \
        'nbody': { \
            'bare': {'rss_mb': 5, 'app_ms': 1}, \
            'lua': {'rss_mb': 1, 'app_ms': 1} \
        } \
    }}
    unittestEqual( \
        perfMemoryExtra(dataNotBest), \
        "BareScript (C)'s minimum footprint is 5.0 MB, the second lowest." \
    )
    dataAll = {'crossLanguage': { \
        'empty': { \
            'bare': {'rss_mb': 1, 'wall_ms': 2}, \
            'lua': {'rss_mb': 2, 'wall_ms': 2} \
        }, \
        'nbody': { \
            'bare': {'rss_mb': 1, 'app_ms': 1}, \
            'lua': {'rss_mb': 2, 'app_ms': 1} \
        } \
    }}
    unittestEqual( \
        perfMemoryExtra(dataAll), \
        "BareScript (C)'s minimum footprint is 1.0 MB, the lowest, and 2.0x lighter than Lua, " + \
            'the next lightest. BareScript (C) is the lightest on every application.' \
    )
    dataSomeWins = {'crossLanguage': { \
        'empty': { \
            'bare': {'rss_mb': 20, 'wall_ms': 2}, \
            'lua': {'rss_mb': 1, 'wall_ms': 2} \
        }, \
        'nbody': { \
            'bare': {'rss_mb': 1, 'app_ms': 1}, \
            'lua': {'rss_mb': 10, 'app_ms': 1} \
        } \
    }}
    unittestEqual( \
        perfMemoryExtra(dataSomeWins), \
        "BareScript (C)'s minimum footprint is 20.0 MB, the second lowest. BareScript (C) is " + \
            'the lightest on nbody.' \
    )
endfunction
unittestRunTest('testPerfMemoryBlurb_empty')


function testPerfMethod():
    unittestEqual( \
        perfMethod(testPerfData), \
        'Each timing is the lowest of its runs; the cross-language suite ran each application 3 ' + \
            'times. The size and memory figures come from one run apiece. `make perf-data` ' + \
            're-measures all three and rewrites the files this page reads. The cross-language ' + \
            "suite's applications, ports, and protocol are described in " + \
            '[perfx/README.md](https://github.com/craigahobbs/bare-script-c/blob/main/perfx/README.md).' + \
            '\n\nThe cross-language suite ran these interpreters:\n\n' + \
            '- **BareScript (C):** `1.0.0`\n' + \
            '- **JavaScript (V8 JIT):** `v26.8.2`\n' + \
            '- **Lua:** `Lua 5.5.1`' \
    )
    unittestEqual(stringStartsWith(perfMethod({}), 'Each timing is the lowest of its runs. '), true)
    unittestEqual(perfVersionList({}), '')
endfunction
unittestRunTest('testPerfMethod')


function testPerfCrossBlurb_empty():
    unittestEqual(perfCrossBlurb({}), '`make perfx` runs the cross-language application suite.')
endfunction
unittestRunTest('testPerfCrossBlurb_empty')


function testPerfCrossLead():
    unittestEqual( \
        perfCrossLead(testPerfData), \
        '`make perfx` runs an n-body simulation (300,000 steps) and grid pathfinding (800 x 800 ' + \
            'cells), each ported line for line to the languages in the table. Each figure is ' + \
            'application time, the best of 3 runs; the program clocks itself, so interpreter ' + \
            'startup is not counted. A blank cell is a port that failed or whose result did not ' + \
            'match the others.' \
    )
    data = jsonParse(jsonStringify(testPerfData))
    objectDelete(data, 'runs')
    objectDelete(objectGet(objectGet(objectGet(data, 'crossLanguage'), 'nbody'), 'bare'), 'n')
    unittestEqual( \
        perfCrossLead(data), \
        '`make perfx` runs an n-body simulation and grid pathfinding (800 x 800 cells), each ' + \
            'ported line for line to the languages in the table. Each figure is application time; ' + \
            'the program clocks itself, so interpreter startup is not counted. A blank cell is a ' + \
            'port that failed or whose result did not match the others.' \
    )
endfunction
unittestRunTest('testPerfCrossLead')


