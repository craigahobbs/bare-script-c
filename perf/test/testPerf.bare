function testPerfCells_best():
    csv = 'language,test,runs,timeMs\n' + \
        'BareScript (C),mandelbrot,1000,9000\n' + \
        'BareScript (C),mandelbrot,1000,8000\n' + \
        'BareScript (C),testSuite,1000,160000\n' + \
        'JavaScript,urlEncode,1000,2\n' + \
        'short,row\n'
    cells = perfCells(csv)
    unittestEqual(objectGet(objectGet(cells, 'BareScript (C)'), 'mandelbrot'), 8000)
    unittestEqual(objectGet(objectGet(cells, 'BareScript (C)'), 'testSuite'), 160000)
    unittestEqual(objectGet(objectGet(cells, 'JavaScript (V8)'), 'urlEncode'), 2)
endfunction
unittestRunTest('testPerfCells_best')


function testPerfCells_null():
    unittestDeepEqual(perfCells(null), {})
endfunction
unittestRunTest('testPerfCells_null')


async function testPerfLoad_plainSummary():
    unittestMockAll({'systemFetch': { \
        'data/perf.csv': 'language,test,runs,timeMs\n', \
        'data/perfx.json': jsonStringify(objectGet(testPerfData, 'crossLanguage')), \
        'data/size.json': testPerfSizeJson(testPerfData) \
    }})
    data = perfLoad()
    unittestMockEnd()
    unittestEqual(objectGet(objectGet(objectGet(data, 'crossLanguage'), 'empty'), 'bare') != null, true)
    unittestEqual(objectGet(data, 'versions'), null)
    unittestEqual(objectGet(data, 'runs'), null)
endfunction
unittestRunTest('testPerfLoad_plainSummary')


async function testPerfLoad_badJson():
    systemLogDebug('NOTICE: The following "jsonParse" error is expected:')
    unittestMockAll({'systemFetch': { \
        'data/perf.csv': 'language,test,runs,timeMs\n', \
        'data/perfx.json': 'not-json', \
        'data/size.json': testPerfSizeJson(testPerfData) \
    }})
    unittestEqual(perfLoad(), null)
    unittestMockEnd()
endfunction
unittestRunTest('testPerfLoad_badJson')


function testPerfFetchNull(urls):
    return if(arrayLength(urls) < 0, [], null)
endfunction


function testPerfFetchShort(urls):
    return if(arrayLength(urls) < 0, [], ['a', 'b'])
endfunction


async function testPerfLoad_fetchNull():
    unittestMockOne('systemFetch', testPerfFetchNull)
    unittestEqual(perfLoad(), null)
    unittestMockEnd()
endfunction
unittestRunTest('testPerfLoad_fetchNull')


async function testPerfLoad_shortFetch():
    unittestMockOne('systemFetch', testPerfFetchShort)
    unittestEqual(perfLoad(), null)
    unittestMockEnd()
endfunction
unittestRunTest('testPerfLoad_shortFetch')


async function testPerfLoad_noSummary():
    unittestMockAll({'systemFetch': { \
        'data/perf.csv': 'language,test,runs,timeMs\n', \
        'data/perfx.json': '{}', \
        'data/size.json': testPerfSizeJson(testPerfData) \
