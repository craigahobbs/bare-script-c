    unittestDeepEqual(perfFastestApps({}, ['nbody'], 'bare'), [])
    unittestDeepEqual( \
        perfFastestApps({'bare': [null], 'js': [1]}, ['nbody'], 'bare'), \
        [] \
    )
endfunction
