# A port whose result did not match the others has no time
function testPerfTimeRows_failedPort():
    data = jsonParse(jsonStringify(testPerfData))
    objectSet(objectGet(objectGet(objectGet(data, 'crossLanguage'), 'nbody'), 'js'), 'ok', false)
    unittestDeepEqual(objectGet(perfTimeRows(data), 'js'), [null, 130])
endfunction
unittestRunTest('testPerfTimeRows_failedPort')


