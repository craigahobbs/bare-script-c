function testPerfLeadsOthers_gaps():
    unittestEqual(perfLeadsOthers({}, 'bare', ['js']), false)
    unittestEqual(perfLeadsOthers({'bare': [1]}, 'bare', ['js']), false)
    unittestEqual(perfLeadsOthers({'bare': [null], 'lua': [2]}, 'bare', ['js']), false)
    unittestEqual(perfLeadsOthers({'bare': [3], 'lua': [2]}, 'bare', ['js']), false)
endfunction
unittestRunTest('testPerfLeadsOthers_gaps')


function testPerfIncludeStanding():
    unittestEqual(perfIncludeStanding({}), '')
    unittestEqual( \
        perfIncludeStanding(testPerfData), \
        'On this suite, BareScript (C) is 2.2x slower than JavaScript (V8), and 11.3x slower than ' + \
            'C (mandelbrot).' \
    )
    # The other BareScript implementations are not what the standing ranks it among
    references = {'includeLibrary': { \
        'BareScript (C)': {'mandelbrot': 9000}, \
