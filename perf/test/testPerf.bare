function testPerfIntroStartup_notBest():
    data = {'crossLanguage': {'empty': { \
        'bare': {'wall_ms': 2.7, 'rss_mb': 2.5}, \
        'lua': {'wall_ms': 2.4, 'rss_mb': 1.7} \
    }}}
    unittestEqual(perfIntroStartup(data), '- **Startup:** 2.7 ms, the second fastest.')
    objectSet(objectGet(objectGet(objectGet(data, 'crossLanguage'), 'empty'), 'lua'), 'wall_ms', 2.68)
    unittestEqual(perfIntroStartup(data), '- **Startup:** 2.7 ms, tied with Lua for the fastest.')
endfunction
unittestRunTest('testPerfIntroStartup_notBest')


function testPerfLanguageName_unknown():
    unittestEqual(perfLanguageName('nope'), 'nope')
endfunction
unittestRunTest('testPerfLanguageName_unknown')


function testPerfChunks():
    unittestDeepEqual(perfChunks([], 6), [])
    unittestDeepEqual(perfChunks(['a', 'b'], 6), [['a', 'b']])
    unittestDeepEqual(perfChunks(['a', 'b', 'c'], 2), [['a', 'b'], ['c']])
    unittestDeepEqual( \
        perfChunks(['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i'], 6), \
        [['a', 'b', 'c', 'd', 'e'], ['f', 'g', 'h', 'i']] \
    )
    unittestDeepEqual(perfChunks(['a'], 0), [])
    unittestEqual(perfSplitNote(6), '')
    unittestEqual(perfSplitNote(7), 'At most 6 tests per table.')
endfunction
unittestRunTest('testPerfChunks')


function testPerfJoinAnd():
    unittestEqual(perfJoinAnd([]), '')
    unittestEqual(perfJoinAnd(['a']), 'a')
    unittestEqual(perfJoinAnd(['a', 'b']), 'a and b')
    unittestEqual(perfJoinAnd(['a', 'b', 'c']), 'a, b, and c')
    unittestEqual(perfJoinParts([], ' '), '')
    unittestEqual(perfJoinParts(['a', '', 'b'], ' '), 'a b')
endfunction
unittestRunTest('testPerfJoinAnd')


function testPerfCrossWins_leads():
