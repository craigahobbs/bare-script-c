        perfCrossWins(testPerfData), \
        'BareScript (C) leads every interpreter on every application.' \
    )
endfunction
unittestRunTest('testPerfCrossWins_leads')


function testPerfCrossWins_wins():
    data = jsonParse(jsonStringify(testPerfData))
    objectSet(objectGet(objectGet(objectGet(data, 'crossLanguage'), 'nbody'), 'bare'), 'app_ms', 10)
    objectSet(objectGet(objectGet(objectGet(data, 'crossLanguage'), 'pathfind'), 'bare'), 'app_ms', 10)
    unittestEqual(perfCrossWins(data), 'BareScript (C) is the fastest on every application.')
    objectSet(objectGet(objectGet(objectGet(data, 'crossLanguage'), 'pathfind'), 'bare'), 'app_ms', 430)
    unittestEqual( \
        perfCrossWins(data), \
        'BareScript (C) is the fastest on nbody and leads every interpreter on every application.' \
    )
endfunction
unittestRunTest('testPerfCrossWins_wins')


