include <unittestMock.bare>
include '../perf.bare'


# A small snapshot so page-render tests do not depend on the published numbers
testPerfData = { \
    'when': '2026-01-01', \
    'machine': 'test', \
    'includeLibrary': { \
        'BareScript (C)': { \
            'mandelbrot': 9000, 'schemaParse': 90, 'schemaValidate': 120, \
            'markdownParse': 700, 'markdownElements': 200, 'qrcodeMatrix': 900, \
            'urlEncode': 4, 'urlDecode': 5, 'testSuite': 160000 \
        }, \
        'JavaScript (V8)': { \
            'mandelbrot': 1500, 'schemaParse': 70, 'schemaValidate': 50, \
            'markdownParse': 600, 'markdownElements': 30, \
            'urlEncode': 2, 'urlDecode': 5 \
        }, \
        'BareScript (JS)': { \
            'mandelbrot': 90000, 'schemaParse': 900, 'schemaValidate': 1200, \
            'markdownParse': 7000, 'markdownElements': 2000, 'qrcodeMatrix': 9000, \
            'urlEncode': 40, 'urlDecode': 50, 'testSuite': 1600000 \
        }, \
        'C': {'mandelbrot': 800} \
    }, \
    'crossLanguage': { \
        'empty': { \
            'bare': {'app_ms': 0, 'wall_ms': 2.5, 'rss_mb': 2.5}, \
            'js': {'app_ms': 0, 'wall_ms': 26, 'rss_mb': 38}, \
            'jsless': {'app_ms': 0, 'wall_ms': 28, 'rss_mb': 37}, \
            'lua': {'app_ms': 0, 'wall_ms': 2.6, 'rss_mb': 1.7} \
        }, \
        'nbody': { \
            'bare': {'app_ms': 340, 'rss_mb': 2.6, 'n': 300000}, \
            'js': {'app_ms': 17, 'rss_mb': 44}, \
            'jsless': {'app_ms': 800, 'rss_mb': 40}, \
            'lua': {'app_ms': 590, 'rss_mb': 1.8} \
        }, \
        'pathfind': { \
            'bare': {'app_ms': 430, 'rss_mb': 17, 'n': 800}, \
            'js': {'app_ms': 130, 'rss_mb': 69}, \
            'jsless': {'app_ms': 730, 'rss_mb': 86}, \
            'lua': {'app_ms': 460, 'rss_mb': 39} \
        } \
    }, \
    'versions': {'bare': '1.0.0', 'js': 'v26.8.2', 'lua': 'Lua 5.5.1'}, \
    'runs': 3, \
    'measure': { \
        'emptyRss': 2.5, 'emptyPeak': 1.7, 'perfRss': 6, 'suiteRss': 28, 'coverRss': 46, \
        'dylibBytes': 436224, 'textBytes': 218112, 'includeBytes': 126976 \
    } \
}

function testPerfCsv(includeLibrary):
    lines = ['language,test,runs,timeMs']
    for language in objectKeys(includeLibrary):
        tests = objectGet(includeLibrary, language)
        for testName in objectKeys(tests):
            arrayPush(lines, language + ',' + testName + ',1000,' + objectGet(tests, testName))
        endfor
    endfor
    return arrayJoin(lines, '\n')
endfunction


function testPerfSizeJson(data):
    size = objectCopy(objectGet(data, 'measure'))
    objectSet(size, 'when', objectGet(data, 'when'))
    objectSet(size, 'machine', objectGet(data, 'machine'))
    return jsonStringify(size)
endfunction


function testPerfFetch(data):
    return { \
        'data/perf.csv': testPerfCsv(objectGet(data, 'includeLibrary')), \
        'data/perfx.json': jsonStringify({ \
            'summary': objectGet(data, 'crossLanguage'), \
            'versions': objectGet(data, 'versions'), \
            'runs_per_test': objectGet(data, 'runs') \
        }), \
        'data/size.json': testPerfSizeJson(data) \
    }
endfunction


async function testPerfMain_missingData():
    unittestMockAll()
    perfMain()
    unittestDeepEqual( \
        unittestMockEnd(), \
        [ \
            ['systemFetch', [[perfDataCsv, perfDataPerfx, perfDataSize]]], \
            ['markdownPrint', ['**Error:** Failed to load performance data']] \
        ] \
    )
endfunction
unittestRunTest('testPerfMain_missingData')


async function testPerfMain():
    unittestMockAll({'systemFetch': testPerfFetch(testPerfData)})
    perfMain()
    unittestDeepEqual( \
        unittestMockEnd(), \
        [ \
            ['systemFetch', [[perfDataCsv, perfDataPerfx, perfDataSize]]], \
            ['documentSetTitle', [perfTitle]], \
            ['markdownPrint', [ \
                '[Home](../)', \
                '', \
                '# ' + perfTitle, \
                '', \
                perfIntro(testPerfData), \
                '', \
                '`make perfx` and `make perf` compare this runtime with V8, CPython, Lua, Ruby, Perl, and the ' + \
                    'JavaScript and Python BareScript implementations. Lower is better throughout. Each ' + \
                    "table's last column scores a language against the best one, so 1x is the best and 2x " + \
                    'costs twice as much; a difference under about 5% is run-to-run drift.', \
                '', \
                'Measured on ' + markdownEscape('test') + ', 2026-01-01.', \
                '', \
                '[Source](https://github.com/craigahobbs/bare-script-c)', \
                '', \
                '## Cross-Language Benchmarks', \
                '', \
                perfCrossBlurb(testPerfData), \
                '', \
                perfTableLanguages(testPerfData), \
                '', \
                '## Include Library Benchmarks', \
                '', \
                perfIncludeBlurb(testPerfData), \
                '', \
                perfTableInclude(testPerfData), \
                '', \
                '## Memory', \
                '', \
                perfMemoryBlurb(testPerfData), \
                '', \
                perfTableMemory(testPerfData), \
                '', \
                '## Startup', \
                '', \
                perfStartupBlurb(testPerfData), \
                '', \
                perfTableStartup(testPerfData), \
                '', \
                '## Size', \
                '', \
                perfSizeLead, \
                '', \
                perfTableSize(testPerfData), \
                '', \
                '## Method', \
                '', \
                perfMethod(testPerfData) \
            ]] \
        ] \
    )
endfunction
unittestRunTest('testPerfMain')


# The opener names this runtime's place among the interpreters, the JIT set aside
function testPerfIntroClaim():
    unittestEqual(perfIntroClaim({}), '')
    unittestEqual( \
        perfIntroClaim(testPerfData), \
        'It is the fastest interpreter among the languages measured here (JavaScript and Lua).' \
    )
    unittestEqual(perfPlainName('Python'), 'Python')
endfunction
unittestRunTest('testPerfIntroClaim')


function testPerfIntroClaim_secondFastest():
    data = {'crossLanguage': { \
        'empty': { \
            'bare': {'wall_ms': 2, 'rss_mb': 2}, \
            'py': {'wall_ms': 2, 'rss_mb': 2}, \
            'lua': {'wall_ms': 2, 'rss_mb': 2} \
        }, \
        'nbody': { \
            'bare': {'app_ms': 20, 'rss_mb': 2}, \
            'py': {'app_ms': 30, 'rss_mb': 2}, \
            'lua': {'app_ms': 10, 'rss_mb': 2} \
        } \
    }}
    unittestEqual( \
        perfIntroClaim(data), \
        'It is the second fastest interpreter among the languages measured here (Python and Lua).' \
    )
endfunction
unittestRunTest('testPerfIntroClaim_secondFastest')


# With nothing to measure it against there is no claim to make
function testPerfIntroClaim_alone():
    data = {'crossLanguage': { \
        'empty': {'bare': {'wall_ms': 2, 'rss_mb': 2}}, \
        'nbody': {'bare': {'app_ms': 20, 'rss_mb': 2}} \
    }}
    unittestEqual(perfIntroClaim(data), '')
endfunction
unittestRunTest('testPerfIntroClaim_alone')


function testPerfIntro_fallback():
    unittestEqual(perfIntro({}), 'BareScript (C) is a plain bytecode interpreter with no JIT.')
    unittestEqual( \
        perfIntro({'includeLibrary': { \
            'C': {'mandelbrot': 1}, \
            'BareScript (C)': {'mandelbrot': 2} \
        }}), \
        'BareScript (C) is a plain bytecode interpreter with no JIT.\n\n' + \
            '- **Performance:** 2.0x slower than C (mandelbrot).' \
    )
endfunction
unittestRunTest('testPerfIntro_fallback')


function testPerfIntroPerformance():
    unittestEqual(perfIntroPerformance({}), '')
    unittestEqual( \
        perfIntroPerformance(testPerfData), \
        '- **Performance:** 1.4x faster than Lua. 8.1x slower than JavaScript (V8 JIT). ' + \
            '11.3x slower than C (mandelbrot).' \
    )
endfunction
unittestRunTest('testPerfIntroPerformance')


# Nothing on one side of it, and nothing on either. Only the language it beats takes the label.
function testPerfNeighbors_ends():
    unittestDeepEqual(perfNeighbors({}, 'bare', ', the next slowest'), [])
    unittestDeepEqual(perfNeighbors({'bare': 1}, 'bare', ', the next slowest'), [])
    unittestDeepEqual( \
        perfNeighbors({'bare': 1, 'js': 2.4}, 'bare', ', the next slowest'), \
        ['2.4x faster than JavaScript (V8 JIT), the next slowest'] \
    )
    unittestDeepEqual( \
        perfNeighbors({'js': 1, 'bare': 2.4}, 'bare', ''), \
        ['2.4x slower than JavaScript (V8 JIT)'] \
    )
    unittestDeepEqual(perfJoinSerial([]), '')
    unittestDeepEqual(perfJoinSerial(['a']), 'a')
    unittestDeepEqual(perfJoinSerial(['a', 'b']), 'a, and b')
endfunction
unittestRunTest('testPerfNeighbors_ends')


function testPerfIntroSize():
    unittestEqual(perfIntroSize({}), '')
    unittestEqual(perfIntroSize({'measure': {}}), '')
    unittestEqual(perfIntroSize(testPerfData), '- **Size:** A 426 KB shared library.')
endfunction
unittestRunTest('testPerfIntroSize')


function testPerfCrossStanding():
    unittestEqual(perfCrossStanding({}), '')
    unittestEqual(perfCrossStanding({'bare': 1}), '')
    unittestEqual( \
        perfCrossStanding({'bare': 1, 'js': 2.4}), \
        'On this suite, BareScript (C) is 2.4x faster than JavaScript (V8 JIT), the next slowest.' \
    )
    unittestEqual( \
        perfCrossStanding({'js': 1, 'bare': 2.42}), \
        'On this suite, BareScript (C) is 2.4x slower than JavaScript (V8 JIT).' \
    )
    unittestEqual( \
        perfCrossStanding({'js': 1, 'lua': 1.5, 'bare': 2.4, 'rb': 4.8}), \
        'On this suite, BareScript (C) is 2.0x faster than Ruby, the next slowest, and 1.6x ' + \
            'slower than Lua.' \
    )
endfunction
unittestRunTest('testPerfCrossStanding')


