# BareScript library tests


function testLibraryArray():
    unittestEqual(arrayCopy([1, 2]), [1, 2])
    unittestEqual(arrayLength([1, 2, 3]), 3)
    unittestEqual(arrayGet([1, 2], 1), 2)
    unittestEqual(arrayNew(1, 'a'), [1, 'a'])
    unittestEqual(arrayNewSize(3, 'z'), ['z', 'z', 'z'])
    unittestEqual(arrayExtend([1], [2, 3]), [1, 2, 3])
    unittestEqual(arrayFlat([1, [2, [3, [4]]]]), [1, 2, 3, 4])
    unittestEqual(arrayFlat([1, [2, [3]]], 1), [1, 2, [3]])
    unittestEqual(arrayIndexOf([5, -3, 7], -3), 1)
    unittestEqual(arrayLastIndexOf([1, 2, 1], 1), 2)
    unittestEqual(arrayJoin([1, null, 'x'], '|'), '1|null|x')
    unittestEqual(arraySlice([1, 2, 3, 4], 1, 3), [2, 3])
    unittestEqual(arrayReverse([1, 2, 3]), [3, 2, 1])
    unittestEqual(arraySort([3, 1, 2]), [1, 2, 3])

    # In-place mutation
    values = [1, 2, 3]
    unittestEqual(arrayPop(values), 3)
    unittestEqual(values, [1, 2])
    unittestEqual(arrayShift(values), 1)
    unittestEqual(values, [2])
    unittestEqual(arrayPush(values, 3, 4), [2, 3, 4])
    arrayDelete(values, 0)
    unittestEqual(values, [3, 4])
    unittestEqual(arraySet(values, 0, 'x'), 'x')
    unittestEqual(values, ['x', 4])

    # Invalid arguments return the documented error values
    systemLogDebug('NOTICE: The following "arrayGet" error is expected:')
    unittestEqual(arrayGet([1], 5), null)
    systemLogDebug('NOTICE: The following "arrayLength" error is expected:')
    unittestEqual(arrayLength('not an array'), 0)
    systemLogDebug('NOTICE: The following "arrayIndexOf" error is expected:')
    unittestEqual(arrayIndexOf('not an array', 1), -1)
endfunction
unittestRunTest('testLibraryArray')


function testLibraryArrayIsNegative(value):
    return value < 0
endfunction

function testLibraryArrayCompareDesc(a, b):
    return b - a
endfunction

function testLibraryArrayFunctions():
    unittestEqual(arrayIndexOf([5, -3, 7], testLibraryArrayIsNegative), 1)
    unittestEqual(arrayLastIndexOf([-5, -3, 7], testLibraryArrayIsNegative), 1)
    unittestEqual(arraySort([1, 3, 2], testLibraryArrayCompareDesc), [3, 2, 1])
endfunction
unittestRunTest('testLibraryArrayFunctions')


function testLibraryObject():
    person = {'name': 'Alice'}
    unittestEqual(objectGet(person, 'name'), 'Alice')
    unittestEqual(objectGet(person, 'city', 'Unknown'), 'Unknown')
    unittestEqual(objectHas(person, 'name'), true)
    unittestEqual(objectHas(person, 'city'), false)
    unittestEqual(objectSet(person, 'age', 30), 30)
    unittestEqual(objectKeys(person), ['name', 'age'])
    unittestEqual(objectAssign(objectCopy(person), {'city': 'NYC'}), \
        objectNew('age', 30, 'city', 'NYC', 'name', 'Alice'))
    objectDelete(person, 'age')
    unittestEqual(objectKeys(person), ['name'])
    unittestEqual(objectNew('a', 1, 'b'), objectNew('a', 1, 'b', null))

    # Objects serialize with sorted keys and iterate in insertion order
    ordered = objectNew('z', 1, 'a', 2)
    unittestEqual(objectKeys(ordered), ['z', 'a'])
    unittestEqual(jsonStringify(ordered), '{"a":2,"z":1}')
endfunction
unittestRunTest('testLibraryObject')


function testLibraryString():
    text = 'Hello, World'
    unittestEqual(stringLength(text), 12)
    unittestEqual(stringCharAt(text, 1), 'e')
    unittestEqual(stringCharCodeAt(text, 0), 72)
    unittestEqual(stringIndexOf(text, 'o'), 4)
    unittestEqual(stringIndexOf(text, 'o', 5), 8)
    unittestEqual(stringLastIndexOf(text, 'o'), 8)
    unittestEqual(stringSlice(text, 7), 'World')
    unittestEqual(stringSlice(text, 0, 5), 'Hello')
    unittestEqual(stringStartsWith(text, 'Hello'), true)
    unittestEqual(stringEndsWith(text, 'World'), true)
    unittestEqual(stringLower(text), 'hello, world')
    unittestEqual(stringUpper(text), 'HELLO, WORLD')
    unittestEqual(stringTrim('  x  '), 'x')
    unittestEqual(stringRepeat('ab', 3), 'ababab')
    unittestEqual(stringReplace('a-a-a', '-', '+'), 'a+a+a')
    unittestEqual(stringSplit('a,b,c', ','), ['a', 'b', 'c'])
    unittestEqual(stringSplit('abc', ''), ['a', 'b', 'c'])
    unittestEqual(stringNew(1), '1')
    unittestEqual(stringNew([1, 2]), '[1,2]')
    unittestEqual(stringEncode('ab'), [97, 98])
    unittestEqual(stringDecode([104, 105]), 'hi')
    unittestEqual(stringFromCharCode(72, 105), 'Hi')

    # Unicode strings index by code point
    unicode = stringFromCharCode(97, 233, 28450, 128512, 122)
    unittestEqual(stringLength(unicode), 5)
    unittestEqual(stringCharCodeAt(unicode, 3), 128512)
    unittestEqual(stringLength(stringSlice(unicode, 1, 4)), 3)
    unittestEqual(stringDecode(stringEncode(unicode)), unicode)

    # Invalid arguments
    systemLogDebug('NOTICE: The following "stringLength" error is expected:')
    unittestEqual(stringLength(1), 0)
    systemLogDebug('NOTICE: The following "stringIndexOf" error is expected:')
    unittestEqual(stringIndexOf(1, 'a'), -1)
    systemLogDebug('NOTICE: The following "stringCharAt" error is expected:')
    unittestEqual(stringCharAt(text, 99), null)
endfunction
unittestRunTest('testLibraryString')


function testLibraryMath():
    unittestEqual(mathAbs(-2), 2)
    unittestEqual(mathCeil(1.2), 2)
    unittestEqual(mathFloor(1.8), 1)
    unittestEqual(mathRound(1.5), 2)
    unittestEqual(mathRound(2.345, 2), 2.35)
    unittestEqual(mathSign(-3), -1)
    unittestEqual(mathSqrt(9), 3)
    unittestEqual(mathMax(1, 5, 3), 5)
    unittestEqual(mathMin(1, 5, 3), 1)
    unittestEqual(mathLog(8, 2), 3)
    unittestEqual(mathLn(1), 0)
    unittestEqual(mathCos(0), 1)
    unittestEqual(mathSin(0), 0)
    unittestEqual(mathAtan2(0, 1), 0)
    unittestTrue(mathPi() > 3.14 && mathPi() < 3.15)
    unittestTrue(mathE() > 2.71 && mathE() < 2.72)
    unittestTrue(mathRandom() >= 0 && mathRandom() < 1)
    systemLogDebug('NOTICE: The following "mathSqrt" error is expected:')
    unittestEqual(mathSqrt(-1), null)
endfunction
unittestRunTest('testLibraryMath')


function testLibraryNumber():
    unittestEqual(numberParseFloat('1.5'), 1.5)
    unittestEqual(numberParseFloat('x'), null)
    unittestEqual(numberParseInt('ff', 16), 255)
    unittestEqual(numberParseInt('12'), 12)
    unittestEqual(numberToFixed(3.14159), '3.14')
    unittestEqual(numberToFixed(3.14159, 3), '3.142')
    unittestEqual(numberToFixed(3, 2, true), '3')
    unittestEqual(numberToString(255, 16), 'ff')
    unittestEqual(numberToString(0), '0')
endfunction
unittestRunTest('testLibraryNumber')


function testLibraryJSON():
    unittestEqual(jsonStringify({'b': 2, 'a': 1}), '{"a":1,"b":2}')
    unittestEqual(jsonStringify([1, 2], 2), '[\n  1,\n  2\n]')
    unittestEqual(jsonParse('{"a": [1, 2, {"b": null}]}'), \
        objectNew('a', arrayNew(1, 2, objectNew('b', null))))
    systemLogDebug('NOTICE: The following "jsonParse" error is expected:')
    unittestEqual(jsonParse('not json'), null)
    unittestEqual(jsonParse(jsonStringify({'a': [1, 'two', true, null]})), \
        objectNew('a', arrayNew(1, 'two', true, null)))
endfunction
unittestRunTest('testLibraryJSON')


function testLibraryDatetime():
    d = datetimeNew(2026, 8, 6, 7, 30, 15, 250)
    unittestEqual(datetimeYear(d), 2026)
    unittestEqual(datetimeMonth(d), 8)
    unittestEqual(datetimeDay(d), 6)
    unittestEqual(datetimeHour(d), 7)
    unittestEqual(datetimeMinute(d), 30)
    unittestEqual(datetimeSecond(d), 15)
    unittestEqual(datetimeMillisecond(d), 250)
    unittestEqual(datetimeISOFormat(d, true), '2026-08-06')
    unittestEqual(datetimeISOParse(datetimeISOFormat(d)), d)
    unittestEqual(datetimeISOParse('bad'), null)

    # Component normalization
    unittestEqual(datetimeMonth(datetimeNew(2026, 13, 1)), 1)
    unittestEqual(datetimeYear(datetimeNew(2026, 13, 1)), 2027)
    unittestEqual(datetimeDay(datetimeNew(2026, 1, 32)), 1)
    unittestEqual(datetimeMonth(datetimeNew(2026, 1, 32)), 2)
    unittestEqual(datetimeDay(datetimeNew(2024, 2, 29)), 29)

    # Datetime arithmetic
    unittestEqual(datetimeNew(2026, 8, 6) - datetimeNew(2026, 8, 5), 86400000)
    unittestEqual(datetimeDay(datetimeNew(2026, 8, 5) + 86400000), 6)
    unittestTrue(datetimeNow() > datetimeNew(2020, 1, 1))
    unittestEqual(datetimeHour(datetimeToday()), 0)
endfunction
unittestRunTest('testLibraryDatetime')


function testLibraryRegex():
    match = regexMatch(regexNew('(?<year>[0-9]{4})-(?<month>[0-9]{2})'), 'on 2026-08-06')
    unittestEqual(objectGet(match, 'index'), 3)
    unittestEqual(objectGet(objectGet(match, 'groups'), '0'), '2026-08')
    unittestEqual(objectGet(objectGet(match, 'groups'), 'year'), '2026')
    unittestEqual(objectGet(objectGet(match, 'groups'), 'month'), '08')
    unittestEqual(regexMatch(regexNew('z'), 'abc'), null)

    matches = regexMatchAll(regexNew('[0-9]+'), 'a1b22c333')
    unittestEqual(arrayLength(matches), 3)
    unittestEqual(objectGet(objectGet(arrayGet(matches, 2), 'groups'), '0'), '333')

    unittestEqual(regexReplace(regexNew('(\\w+) (\\w+)'), 'John Smith', '$2, $1'), 'Smith, John')
    unittestEqual(regexReplace(regexNew('(?<a>x)'), 'axb', '[$<a>]'), 'a[x]b')
    unittestEqual(regexSplit(regexNew('\\s*,\\s*'), 'a , b,c'), ['a', 'b', 'c'])
    unittestEqual(regexEscape('a.b*c'), 'a\\.b\\*c')

    # Flags
    unittestNotEqual(regexMatch(regexNew('ABC', 'i'), 'xabcy'), null)
    unittestEqual(arrayLength(regexMatchAll(regexNew('^.', 'm'), 'ab\ncd')), 2)
    unittestNotEqual(regexMatch(regexNew('a.c', 's'), 'a\nc'), null)
    unittestEqual(regexNew('a', 'q'), null)
    systemLogDebug('NOTICE: The following "regexNew" error is expected:')
    unittestEqual(regexNew('('), null)

    # Lookaround and backreferences
    unittestNotEqual(regexMatch(regexNew('a(?=b)'), 'ab'), null)
    unittestEqual(regexMatch(regexNew('a(?=b)'), 'ac'), null)
    unittestNotEqual(regexMatch(regexNew('(?<=a)b'), 'ab'), null)
    unittestEqual(regexMatch(regexNew('(?<!a)b'), 'ab'), null)
    unittestNotEqual(regexMatch(regexNew('(\\w)\\1'), 'xaay'), null)
    unittestNotEqual(regexMatch(regexNew('(?<w>\\w)\\k<w>'), 'xaay'), null)
endfunction
unittestRunTest('testLibraryRegex')


function testLibrarySystem():
    unittestEqual(systemType(null), 'null')
    unittestEqual(systemType(1), 'number')
    unittestEqual(systemType('a'), 'string')
    unittestEqual(systemType(true), 'boolean')
    unittestEqual(systemType([]), 'array')
    unittestEqual(systemType({}), 'object')
    unittestEqual(systemType(datetimeNow()), 'datetime')
    unittestEqual(systemType(regexNew('a')), 'regex')
    unittestEqual(systemType(systemType), 'function')

    unittestEqual(systemBoolean(0), false)
    unittestEqual(systemBoolean('a'), true)
    unittestEqual(systemCompare(1, 2), -1)

    values = [1]
    unittestEqual(systemIs(values, values), true)
    unittestEqual(systemIs([1], [1]), false)
    unittestEqual(systemIs(1, 1), true)

    unittestEqual(systemGlobalGet('undefinedGlobalName', 'fallback'), 'fallback')
    unittestEqual(systemGlobalSet('testLibrarySystemGlobal', 7), 7)
    unittestEqual(systemGlobalGet('testLibrarySystemGlobal'), 7)
endfunction
unittestRunTest('testLibrarySystem')


function testLibraryBarescript():
    unittestEqual(barescriptEvaluateExpression({'number': 1}), 1)
    unittestEqual(barescriptEvaluateExpression({'variable': 'a'}, {'a': 5}), 5)
    unittestEqual(barescriptEvaluateExpression( \
        {'binary': {'op': '+', 'left': {'number': 1}, 'right': {'number': 2}}}), 3)
    unittestEqual(barescriptEvaluateExpression( \
        {'function': {'name': 'max', 'args': [{'number': 1}, {'number': 5}]}}), 5)
    systemLogDebug('NOTICE: The following "barescriptEvaluateExpression" error is expected:')
    unittestEqual(barescriptEvaluateExpression('not a model'), null)
endfunction
unittestRunTest('testLibraryBarescript')
