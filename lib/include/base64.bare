# $function: base64Encode
# $group: base64.bare
# $doc: Encode an array of byte integer values as a base64 string
# $arg bytes: The array of byte integer values (0-255)
# $return: The base64-encoded string, or null if encoding fails
function base64Encode(bytes):
    if systemType(bytes) != 'array':
        systemLogDebug('base64.bare: base64Encode - Invalid "bytes" argument')
        return null
    endif

    codes = base64Codes
    out = []
    length = arrayLength(bytes)
    ix = 0
    while ix + 3 <= length:
        b0 = arrayGet(bytes, ix)
        b1 = arrayGet(bytes, ix + 1)
        b2 = arrayGet(bytes, ix + 2)
        if systemType(b0) != 'number' || b0 < 0 || b0 > 255 || b0 != (b0 | 0) || \
                systemType(b1) != 'number' || b1 < 0 || b1 > 255 || b1 != (b1 | 0) || \
                systemType(b2) != 'number' || b2 < 0 || b2 > 255 || b2 != (b2 | 0):
            systemLogDebug('base64.bare: base64Encode - Invalid "bytes" argument')
            return null
        endif
        arrayPush(out, arrayGet(codes, b0 >> 2))
        arrayPush(out, arrayGet(codes, ((b0 & 3) << 4) | (b1 >> 4)))
        arrayPush(out, arrayGet(codes, ((b1 & 15) << 2) | (b2 >> 6)))
        arrayPush(out, arrayGet(codes, b2 & 63))
        ix = ix + 3
    endwhile
    remain = length - ix
    if remain == 1:
        b0 = arrayGet(bytes, ix)
        if systemType(b0) != 'number' || b0 < 0 || b0 > 255 || b0 != (b0 | 0):
            systemLogDebug('base64.bare: base64Encode - Invalid "bytes" argument')
            return null
        endif
        arrayPush(out, arrayGet(codes, b0 >> 2))
        arrayPush(out, arrayGet(codes, (b0 & 3) << 4))
        arrayPush(out, 61)
        arrayPush(out, 61)
    elif remain == 2:
        b0 = arrayGet(bytes, ix)
        b1 = arrayGet(bytes, ix + 1)
        if systemType(b0) != 'number' || b0 < 0 || b0 > 255 || b0 != (b0 | 0) || \
                systemType(b1) != 'number' || b1 < 0 || b1 > 255 || b1 != (b1 | 0):
            systemLogDebug('base64.bare: base64Encode - Invalid "bytes" argument')
            return null
        endif
        arrayPush(out, arrayGet(codes, b0 >> 2))
        arrayPush(out, arrayGet(codes, ((b0 & 3) << 4) | (b1 >> 4)))
        arrayPush(out, arrayGet(codes, (b1 & 15) << 2))
        arrayPush(out, 61)
    endif
    return stringDecode(out)
endfunction


# $function: base64Decode
# $group: base64.bare
# $doc: Decode a base64 string to an array of byte integer values
# $arg text: The base64-encoded string
# $return: The array of byte integer values, or null if decoding fails
function base64Decode(text):
    if systemType(text) != 'string':
        systemLogDebug('base64.bare: base64Decode - Invalid "text" argument')
        return null
    endif

    bytes = base64DecodeText(text)
    if bytes == null:
        systemLogDebug('base64.bare: base64Decode - Invalid encoded data')
    endif
    return bytes
endfunction


base64Chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'


function base64DecodeText(text):
    map = base64Map
    length = stringLength(text)
    if length % 4:
        return null
    endif

    bytes = []
    ix = 0
    while ix < length:
        ch = stringCharCodeAt(text, ix)
        if ch > 255:
            return null
        endif
        c0 = arrayGet(map, ch)
        ch = stringCharCodeAt(text, ix + 1)
        if ch > 255:
            return null
        endif
        c1 = arrayGet(map, ch)
        ch = stringCharCodeAt(text, ix + 2)
        if ch > 255:
            return null
        endif
        c2 = arrayGet(map, ch)
        ch = stringCharCodeAt(text, ix + 3)
        if ch > 255:
            return null
        endif
        c3 = arrayGet(map, ch)
        if c0 < 0 || c1 < 0:
            return null
        endif
        arrayPush(bytes, (c0 << 2) | (c1 >> 4))
        if c2 >= 0:
            arrayPush(bytes, ((c1 & 15) << 4) | (c2 >> 2))
            if c3 >= 0:
                arrayPush(bytes, ((c2 & 3) << 6) | c3)
            elif c3 != -2 || ix + 4 != length:
                return null
            endif
        elif c2 != -2 || c3 != -2 || ix + 4 != length:
            return null
        endif
        ix = ix + 4
    endwhile
    return bytes
endfunction


function base64MapNew():
    map = arrayNewSize(256, -1)
    chars = base64Chars
    ix = 0
    while ix < 64:
        arraySet(map, stringCharCodeAt(chars, ix), ix)
        ix = ix + 1
    endwhile
    arraySet(map, 61, -2)
    return map
endfunction


function base64CodesNew():
    codes = []
    chars = base64Chars
    ix = 0
    while ix < 64:
        arrayPush(codes, stringCharCodeAt(chars, ix))
        ix = ix + 1
    endwhile
    return codes
endfunction


base64Map = base64MapNew()
base64Codes = base64CodesNew()
