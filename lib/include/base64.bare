# $function: base64Encode
# $group: base64.bare
# $doc: Encode an array of byte integer values as a base64 string
# $arg bytes: The array of byte integer values (0-255)
# $return: The base64-encoded string, or null if encoding fails
function base64Encode(bytes):
    if !base64IsByteArray(bytes):
        systemLogDebug('base64.bare: base64Encode - Invalid "bytes" argument')
        return null
    endif

    chars = base64Chars
    parts = []
    length = arrayLength(bytes)
    ix = 0
    while ix + 3 <= length:
        b0 = arrayGet(bytes, ix)
        b1 = arrayGet(bytes, ix + 1)
        b2 = arrayGet(bytes, ix + 2)
        arrayPush(parts, stringCharAt(chars, mathFloor(b0 / 4)))
        arrayPush(parts, stringCharAt(chars, (b0 & 3) * 16 + mathFloor(b1 / 16)))
        arrayPush(parts, stringCharAt(chars, (b1 & 15) * 4 + mathFloor(b2 / 64)))
        arrayPush(parts, stringCharAt(chars, b2 & 63))
        ix = ix + 3
    endwhile
    remain = length - ix
    if remain == 1:
        b0 = arrayGet(bytes, ix)
        arrayPush(parts, stringCharAt(chars, mathFloor(b0 / 4)))
        arrayPush(parts, stringCharAt(chars, (b0 & 3) * 16))
        arrayPush(parts, '==')
    elif remain == 2:
        b0 = arrayGet(bytes, ix)
        b1 = arrayGet(bytes, ix + 1)
        arrayPush(parts, stringCharAt(chars, mathFloor(b0 / 4)))
        arrayPush(parts, stringCharAt(chars, (b0 & 3) * 16 + mathFloor(b1 / 16)))
        arrayPush(parts, stringCharAt(chars, (b1 & 15) * 4))
        arrayPush(parts, '=')
    endif
    return arrayJoin(parts, '')
endfunction


# $function: base64Decode
# $group: base64.bare
# $doc: Decode a base64 string to an array of byte integer values
# $arg text: The base64-encoded string
# $return: The array of byte integer values, or null if decoding fails
function base64Decode(text):
    if systemType(text) != 'string':
        systemLogDebug('base64.bare: base64Decode - Invalid "text" argument')
        return null
    endif

    bytes = base64DecodeText(text)
    if bytes == null:
        systemLogDebug('base64.bare: base64Decode - Invalid encoded data')
    endif
    return bytes
endfunction


# True if value is an array of integer byte values (0-255)
function base64IsByteArray(value):
    if systemType(value) != 'array':
        return false
    endif
    for byte in value:
        if systemType(byte) != 'number' || byte != mathFloor(byte) || byte < 0 || byte > 255:
            return false
        endif
    endfor
    return true
endfunction


base64Chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'


function base64DecodeText(text):
    map = base64Map
    length = stringLength(text)
    if length % 4:
        return null
    endif

    bytes = []
    ix = 0
    while ix < length:
        c0 = base64Value(map, text, ix)
        c1 = base64Value(map, text, ix + 1)
        c2 = base64Value(map, text, ix + 2)
        c3 = base64Value(map, text, ix + 3)
        if c0 < 0 || c1 < 0:
            return null
        endif
        arrayPush(bytes, c0 * 4 + mathFloor(c1 / 16))
        if c2 >= 0:
            arrayPush(bytes, (c1 & 15) * 16 + mathFloor(c2 / 4))
            if c3 >= 0:
                arrayPush(bytes, (c2 & 3) * 64 + c3)
            elif c3 != -2 || ix + 4 != length:
                return null
            endif
        elif c2 != -2 || c3 != -2 || ix + 4 != length:
            return null
        endif
        ix = ix + 4
    endwhile
    return bytes
endfunction


function base64Value(map, text, ix):
    ch = stringCharCodeAt(text, ix)
    if ch > 255:
        return -1
    endif
    return arrayGet(map, ch)
endfunction


function base64MapNew():
    map = arrayNewSize(256, -1)
    chars = base64Chars
    ix = 0
    while ix < 64:
        arraySet(map, stringCharCodeAt(chars, ix), ix)
        ix = ix + 1
    endwhile
    arraySet(map, stringCharCodeAt('=', 0), -2)
    return map
endfunction


base64Map = base64MapNew()
